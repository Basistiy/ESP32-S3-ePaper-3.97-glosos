# I2C GPIOs (ES8311 Codec at 0x18)
CONFIG_EXAMPLE_I2C_SCL_IO=42
CONFIG_EXAMPLE_I2C_SDA_IO=41

# I2S GPIOs (Audio Codec)
CONFIG_EXAMPLE_I2S_MCK_IO=13
CONFIG_EXAMPLE_I2S_BCK_IO=14
CONFIG_EXAMPLE_I2S_WS_IO=47
CONFIG_EXAMPLE_I2S_DO_IO=48
CONFIG_EXAMPLE_I2S_DI_IO=21

# Power Amplifier (NS4150B) Enable GPIO (Active HIGH)
CONFIG_EXAMPLE_PA_CTRL_IO=39
